<resources>
    <style name="ReceiverTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/screen_accent</item>
        <item name="android:windowBackground">@color/screen_background</item>
    </style>
    <style name="ReceiverSecondary">
        <item name="android:textColor">@color/screen_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
