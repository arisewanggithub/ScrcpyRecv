<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#E9FFF7" />
            <stroke android:width="3dp" android:color="#A2E9D1" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#C7F5E5" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1D2D3C" />
            <stroke android:width="1dp" android:color="#8FA7BD" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
